    "binding_version",
    "generation_lease_id",
)
PURGE_ATTESTATION = {
    "exclusive_lifecycle_lease": True,
    "quiesce_before_epoch_rotation": True,
    "receipt_committed_before_terminal": True,
    "physical_epoch_isolation": True,
    "active_epoch_mount_only": True,
