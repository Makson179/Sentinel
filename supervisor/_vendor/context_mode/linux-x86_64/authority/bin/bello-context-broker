)
CAPABILITY_TOOLS = frozenset(
    {"ctx_execute", "ctx_execute_file", "ctx_batch_execute", "ctx_purge"}
)
REQUIRED_HOOKS = (
    "PreToolUse",
    "PostToolUse",
    "SessionStart",
    "PreCompact",
    "UserPromptSubmit",
    "Stop",
)
PINNED_CODEX_VERSION = "codex-cli 0.146.0"
PINNED_APPSERVER_SCHEMA = (
    "8b4f3070be27707f5f621196fff0bad967f9b47093737fe1699c859a69d52289"
)
APPROVAL_FIELDS = (
    "role",
    "process_epoch",
    "request_id",
    "thread_id",
    "turn_id",
    "item_id",
    "server",
    "tool",
    "arguments",
